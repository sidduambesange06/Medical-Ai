# =============================================================
# MedBot Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# =============================================================

# ---- Application ----
# Minimum 32-character random string. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

FLASK_ENV=production
FLASK_DEBUG=False

# ---- Supabase (PostgreSQL + Auth) ----
# From your Supabase project Settings > API
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Groq (LLM Inference) ----
# From https://console.groq.com
GROQ_API_KEY=

# ---- OpenAI (optional fallback) ----
OPENAI_API_KEY=

# ---- Pinecone (Vector Database) ----
# From https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1-gcp
PINECONE_INDEX_NAME=medical-chatbot-v2

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- OAuth: Google ----
# From Google Cloud Console > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- OAuth: GitHub ----
# From GitHub > Settings > Developer settings > OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Admin account ----
# Set a strong password. NEVER use default or personal credentials.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Encryption ----
# Used by security_manager to encrypt stored medical data. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MEDAI_ENCRYPTION_KEY=

# ---- Rate limiting ----
RATE_LIMIT_CHAT=50
RATE_LIMIT_WINDOW=3600

# ---- Medical knowledge base ----
MEDICAL_DOCS_PATH=./data/
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
